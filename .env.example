# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (review analysis)
OPENAI_API_KEY=
PAUSE_AI_ANALYSIS=false

# Resend (digest emails)
RESEND_API_KEY=

# Cron
CRON_SECRET=

# Site URL used for Stripe redirect links. Falls back to the request origin
# if unset, but set it explicitly in production.
NEXT_PUBLIC_SITE_URL=https://track-your-app.vercel.app

# Stripe
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Recurring monthly Price ID from https://dashboard.stripe.com/products
STRIPE_PRICE_ID=
# Signing secret from https://dashboard.stripe.com/webhooks (the endpoint
# you add there should point at /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Optional: how the price is displayed on the pricing/upgrade UI.
NEXT_PUBLIC_PRICE_DISPLAY=$9/month
